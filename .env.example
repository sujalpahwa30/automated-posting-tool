# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
APP_NAME=Automated Multi-Platform Posting API
ENVIRONMENT=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:4000
PLATFORM_TIMEOUT_SECONDS=15

# Comma-separated allowlist. Leave empty to auto-enable every platform that has
# credentials, plus the demo platform. Valid keys:
# x, linkedin, telegram, discord, slack, bluesky, mastodon, devto, demo
PLATFORMS=
DEMO_PLATFORM_ENABLED=true

# ---------------------------------------------------------------------------
# X (Twitter) - https://docs.x.com/x-api/posts/create-post
# OAuth 2.0 user-context token with tweet.write (plus tweet.read) scopes.
# ---------------------------------------------------------------------------
X_API_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# LinkedIn - Posts API
# https://learn.microsoft.com/en-us/linkedin/marketing/community-management/shares/posts-api
# Token needs the w_member_social scope. Author must be a full URN.
# LINKEDIN_API_VERSION must be a version currently supported by your app.
# ---------------------------------------------------------------------------
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:xxxxxxxx
LINKEDIN_API_VERSION=202601

# ---------------------------------------------------------------------------
# Telegram - https://core.telegram.org/bots/api#sendmessage
# Create a bot with @BotFather, add it as an admin of a public channel and use
# the channel username (e.g. @my_channel) as TELEGRAM_CHAT_ID.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Discord - Server Settings -> Integrations -> Webhooks
# ---------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Slack - https://api.slack.com/messaging/webhooks
# Apps -> Incoming Webhooks -> Add New Webhook to Workspace, then copy the URL.
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Bluesky - https://docs.bsky.app/docs/tutorials/creating-a-post
# Identifier can be the handle or email; use an App Password, not the main one.
# ---------------------------------------------------------------------------
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE_URL=https://bsky.social

# ---------------------------------------------------------------------------
# Mastodon - Preferences -> Development -> New application (write:statuses)
# ---------------------------------------------------------------------------
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Dev.to - https://dev.to/settings/extensions (DEV API key)
# ---------------------------------------------------------------------------
DEVTO_API_KEY=
